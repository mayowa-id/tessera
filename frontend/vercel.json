{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npx --yes npm@11.6.2 ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/tessera-web/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tessera-backend.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
